<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CompilerHost.cs/ExecutionHost.cs are marked [SupportedOSPlatform("browser")] in the
         browser-wasm worker project; this desktop test project intentionally exercises the
         same platform-agnostic logic outside the browser, so platform-compatibility warnings
         are suppressed for the linked files. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the compiler/execution host source directly instead of project-referencing
         codedotnet.compiler, because that project targets RuntimeIdentifier=browser-wasm and
         cannot be referenced from a normal desktop test project. -->
    <Compile Include="..\codedotnet.compiler\CompilerHost.cs" Link="Source\CompilerHost.cs" />
    <Compile Include="..\codedotnet.compiler\ExecutionHost.cs" Link="Source\ExecutionHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
